# Copy to .env and adjust. Read by docker compose; nothing here is secret.
OPENMW_DATA_DIR="/Users/you/Library/Application Support/openmw"
OPENMW_CONFIG_DIR="/Users/you/Library/Preferences/openmw"

# Optional. Default: $OPENMW_DATA_DIR/Morrowind/Data Files
# MORROWIND_DATA_FILES="/Users/you/Library/Application Support/openmw/Morrowind/Data Files"

# Optional default collection for `./mwpipe.sh run`
# MWPIPE_COLLECTION="https://www.nexusmods.com/games/morrowind/collections/8euesh"

# Optional: path of the file holding your Nexus API key (default ./secrets/nexus_api_key)
# NEXUS_API_KEY_SECRET="./secrets/nexus_api_key"

# Optional: use the published image instead of building locally
# MWPIPE_IMAGE="ghcr.io/<owner>/mwpipe:latest"
